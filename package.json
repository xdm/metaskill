{
  "name": "@xdma/metaskill",
  "version": "0.6.0",
  "description": "Claude Code works out which skills a task needs, vets them against a trust policy, installs them from skills.sh once you say yes, then solves the task.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "metaskill": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "index-snapshot.json",
    "skills",
    "commands",
    "hooks",
    "templates",
    ".claude-plugin",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": "github:xdm/metaskill",
  "homepage": "https://metaskill.dev",
  "keywords": [
    "claude-code",
    "skills",
    "agent-skills",
    "hooks",
    "skills.sh"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node scripts/build.mjs",
    "build:index": "npm run build && node dist/index-builder.js index.json",
    "snapshot": "node dist/snapshot-cli.js",
    "prepublishOnly": "npm run build && npm run snapshot && vitest run",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run --exclude test/integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
